<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Para listar las apps del cajón al crear accesos directos (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TokiPonaIconPack">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Acciones que buscan los launchers para listar icon packs -->
            <intent-filter>
                <action android:name="org.adw.launcher.THEMES" />
                <action android:name="com.novalauncher.THEME" />
                <action android:name="com.teslacoilsw.launcher.THEME" />
                <action android:name="com.gau.go.launcherex.theme" />
                <action android:name="com.fede.launcher.THEME_ICONPACK" />
                <action android:name="com.anddoes.launcher.THEME" />
                <action android:name="ch.deletescape.lawnchair.ICONPACK" />
                <action android:name="app.lawnchair.icons.THEMED_ICON" />
                <action android:name="com.dlto.atom.launcher.THEME" />
                <action android:name="com.lge.launcher2.THEME" />
                <action android:name="ginlemon.smartlauncher.THEMES" />
                <action android:name="com.vivid.launcher.theme" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.anddoes.launcher.THEME" />
                <category android:name="com.fede.launcher.THEME_ICONPACK" />
                <category android:name="com.teslacoilsw.launcher.THEME" />
            </intent-filter>
        </activity>

        <!-- Selector de iconos: el launcher lo abre y recibe el icono elegido. -->
        <activity
            android:name=".IconPickerActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" />
                <action android:name="net.oneplus.launcher.icons.ACTION_PICK_ICON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
